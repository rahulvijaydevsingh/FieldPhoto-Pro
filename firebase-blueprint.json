        "type": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "geofenceId", "userId", "type", "timestamp"]
    },
    "attendance": {
      "title": "Random Attendance Logs",
      "description": "Randomized 3x daily GPS attendance verification logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string" },
        "slots": { "type": "array" }
      },
      "required": ["userId", "date", "slots"]
    }
